# LinkedIn Developer Portal → My Apps → Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must match an Authorised Redirect URL on the app exactly
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback

# LinkedIn versions its API monthly (YYYYMM) and sunsets versions after
# roughly a year. Check before changing.
LINKEDIN_API_VERSION=202506

# Obtained once by visiting /api/linkedin/connect. Treat as a password.
LINKEDIN_REFRESH_TOKEN=

# Any random string. Vercel Cron sends it as a Bearer token so the
# dayparting endpoint cannot be triggered by anyone who finds the URL.
CRON_SECRET=

# Optional. Without it the spend alarm still runs and reports; it just
# does not notify anyone.
SLACK_WEBHOOK_URL=

# --- Google Sheets (feeds Looker Studio) ---
# Paste the entire service account JSON key here as one line.
# Google Cloud → IAM → Service Accounts → Keys → Add key → JSON.
# Enable the Sheets API, then share the spreadsheet with the service
# account's client_email as an Editor. That share step is the one
# everyone forgets.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Morning brief ---
# Resend (resend.com) — free tier covers a daily brief many times over.
# Verify a domain, or use onboarding@resend.dev to test.
RESEND_API_KEY=
BRIEF_FROM="LinkedIn Ads <reports@yourdomain.com>"
BRIEF_TO=you@example.com
# Used for the "Open the monitor" link in the email.
SITE_URL=

# --- Monday.com (Save to Monday.com on the intake form) ---
# An API token from Monday: avatar > Developers > My access tokens.
# Treat as a password. It never reaches the browser; the write happens
# in /api/monday/brief.
MONDAY_API_TOKEN=
# The numeric board ID, from the board URL: /boards/1234567890
MONDAY_BOARD_ID=
# Optional. Without it the item lands in the board's first group.
MONDAY_GROUP_ID=
